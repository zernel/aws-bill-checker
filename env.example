# Notification Webhooks (configure at least one)
# Feishu Webhook URL
FEISHU_WEBHOOK_URL=

# Mattermost Webhook URL
MATTERMOST_WEBHOOK_URL=

# Anomaly Detection Thresholds
# Absolute dollar threshold (default: 50.0)
THRESHOLD_DOLLAR=50.0

# Percentage threshold (default: 25.0)
THRESHOLD_PERCENT=25.0

# Minimum cost for percentage threshold to apply (default: 10.0)
# This prevents small changes like $0.1 -> $0.2 from being flagged as anomalies
THRESHOLD_PERCENT_MIN_COST=10.0

# Currency Settings
# Currency symbol to display (default: $)
# Examples: $, ￥, €, £
CURRENCY_SYMBOL=$

# Language Settings
# Notification language (default: CN)
# Options: CN (Chinese), EN (English)
LANGUAGE=CN

# OpenAI API Settings (optional, for AI-powered bill analysis)
# OpenAI API Base URL (e.g., https://api.openai.com/v1)
OPENAI_API_BASE=

# OpenAI API Key
OPENAI_API_KEY=

# AI model (default: gpt-5.2)
OPENAI_MODEL=gpt-5.2

# Cost Explorer endpoint region (default: us-east-1)
# Multi-deployment note: the mp-cn deployment MUST set cn-north-1 (China partition);
# the kude deployment uses us-east-1.
CE_REGION=us-east-1

# Optional: explicit AWS credential profile (default: follow the default chain)
AWS_PROFILE=

# Dry-run mode: 1 = build and log notifications without sending them (default: off)
DRY_RUN=

